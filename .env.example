# Server Configuration
PORT=4981
LOG_LEVEL=info
APP_ENV=development
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Gemini Configuration
# Open Developer Tools (F12) -> Network, select a Gemini batchexecute request,
# and copy its complete Cookie request header.
GEMINI_COOKIES=
# If that request URL contains /u/2/, set 2 here. Leave empty when the URL has
# no /u/<number>/ segment. The cookie and slot must come from the same tab.
GEMINI_AUTH_USER=
GEMINI_REFRESH_INTERVAL=1440
GEMINI_MAX_RETRIES=3
GEMINI_TEMPORARY=false
# Minutes a video generation may take before it fails with a timeout (default
# 10, maximum 60). Only one video job runs at a time, so a stuck job keeps
# other video requests busy for up to this long.
GEMINI_VIDEO_TIMEOUT_MINUTES=10
# Bearer token for POST /admin/cookies, which lets a browser extension push a
# fresh session without a restart. Leave empty to keep the endpoint disabled
# (the routes are not registered at all). Use a long random value.
GEMINI_COOKIE_API_KEY=
