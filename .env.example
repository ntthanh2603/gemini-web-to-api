# Server Configuration
PORT=4981
LOG_LEVEL=info
APP_ENV=development
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Gemini Configuration
# Open Developer Tools (F12) -> Network, select a Gemini batchexecute request,
# and copy its complete Cookie request header.
GEMINI_COOKIES=
# If that request URL contains /u/2/, set 2 here. Leave empty when the URL has
# no /u/<number>/ segment. The cookie and slot must come from the same tab.
GEMINI_AUTH_USER=
GEMINI_REFRESH_INTERVAL=1440
GEMINI_MAX_RETRIES=3
GEMINI_TEMPORARY=false
